IOP_BIN  = usmb2man.irx
IOP_OBJS = ps2iop-device.o ps2iop-compat.o usmb2.o ntlm.o md4c.o hmac-md5.o md5.o unicode.o imports.o
# The smallest driver, read-only and without timestamps, is
#   -DUSMB2_FEATURE_OPENDIR -DUSMB2_FEATURE_NTLM
IOP_CFLAGS = -Os -mno-check-zero-division -DHAVE_TIMESTAMPS -DUSMB2_FEATURE_OPENDIR -DUSMB2_FEATURE_WRITE -DUSMB2_FEATURE_NTLM \
	-DUSMB2_FEATURE_UNICODE -DUSMB2_FEATURE_STAT -DUSMB2_FEATURE_MKDIR \
	-DUSMB2_FEATURE_UNLINK -DUSMB2_FEATURE_RENAME

all: $(IOP_BIN)

clean:
	rm -f -r $(IOP_OBJS) $(IOP_BIN)

install: $(IOP_BIN)
	cp $(IOP_BIN) $(PS2SDK)/iop/irx

include $(PS2SDK)/Defs.make
include $(PS2SDK)/samples/Makefile.pref
include $(PS2SDK)/samples/Makefile.iopglobal
